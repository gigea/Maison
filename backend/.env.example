# ── MongoDB ───────────────────────────────────────────────
# Local:  mongodb://localhost:27017/fashionshop
# Atlas:  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/fashionshop
MONGO_URI=mongodb://localhost:27017/fashionshop

# ── Server ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Security ──────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING

# ── CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000
