@startuml
title Checkout Sequence
actor Customer
participant "Browser / Frontend"
participant "API Gateway"
participant "Order Service"
participant "Database"

Customer -> "Browser / Frontend" : Click checkout
"Browser / Frontend" -> "API Gateway" : POST /api/orders
"API Gateway" -> "Order Service" : validate auth + cart
"Order Service" -> "Database" : create Order document
"Database" --> "Order Service" : order saved
"Order Service" --> "API Gateway" : order response
"API Gateway" --> "Browser / Frontend" : order confirmation
Browser / Frontend --> Customer : show order summary
@enduml