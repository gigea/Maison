@startuml
title Admin Ban Flow
actor Admin
participant "Admin UI"
participant "API Gateway"
participant "Auth Middleware"
participant "User Service"
participant "Database"

Admin -> "Admin UI" : Click ban/unban user
"Admin UI" -> "API Gateway" : PUT /api/users/{id}/ban
"API Gateway" -> "Auth Middleware" : verify token + admin
"Auth Middleware" -> "API Gateway" : pass / reject
"API Gateway" -> "User Service" : update isBanned flag
"User Service" -> "Database" : save user
"Database" --> "User Service" : updated user
"User Service" --> "API Gateway" : success response
"API Gateway" --> "Admin UI" : updated user state
Admin --> "Admin UI" : view updated list
@enduml